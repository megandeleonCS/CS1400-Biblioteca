# Parte 1: Funciones sin retorno

def mostrar_bienvenida(nombre):
    """Saluda a la persona usando su nombre"""
    print(f"¡Hola, {nombre}! Bienvenido a clase hoy.")

# 1. Nombre es la palabra que se usa para poner el nombre
#    de la persona a la que vamos saludar

# 2. Podemos usar esta función con diferentes nombres sin
#    tener que cambiar el código cada vez


# =============================================================
# Parte 2: Funciones con retorno
# =============================================================

def calcular_descuento(precio, porcentaje=10):
    """Calcula el precio despues de quitar el descuento"""
    descuento = precio * (porcentaje / 100)
    precio_final = precio - descuento
    return precio_final


def es_par(numero):
    """Revisa si un numero es par o impar"""
    return numero % 2 == 0

# 3. La palabra que usamos para crear una función es def.
# 4. Las funciones se llaman calcular_descuento y es_par.
# 5. Si ponemos calcular_descuento(100), se quita el 10%,
#    asi que terminamos pagando 90.
# 6. Si ponemos calcular_descuento(200, 20), se quita el 20 %,
#    así que el precio final es 160.

